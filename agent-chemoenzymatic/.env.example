# Runtime endpoints and credentials for this harness.
# Copy to `.env` and fill in what you need. Never commit `.env`.
# Run main.py check-config after setting endpoints in your deployment YAML or environment.

# -- LLM endpoint (required for planning) -----------------------------
# OpenAI-compatible gateway or API base URL + key. The URL itself lives in the
# agent config (see configs/); this is the credential it authenticates with.
LLM_API_KEY=

# Optional second credential used by the fallback route when the primary
# endpoint keeps failing. Leave blank to disable the fallback.
OPENROUTER_API_KEY=

# -- Retroplanner HTTP service (required for single-step prediction) ---
# Shared service backing the template-free engines (GraphFP, RxNGormer,
# ring-breaker) and used as the default target for single-step queries.
RETROPLANNER_HTTP_URLS=
RETROPLANNER_HTTP_URL=
# Per-engine overrides, if the engines are deployed separately.
CHEMBART_API_URL=
RINGBREAKER_API_URL=

# -- Reaction rater (required by score_route) --------------------------
# Per-step reaction-rater endpoint; the feasibility pillar refuses to construct
# without one.
REACTION_RATER_URL=

# -- Optional assets -------------------------------------------------
# Curated USPTO reaction-template library (rdchiral templates). When absent,
# template-based tools report that the library is unavailable.
RETRO_TEMPLATE_DATASET_DIR=
# Route dump with which scripts/build_precedent_index.py builds the precedent
# memory that recall_similar_routes reads (.pkl takes priority over .hdf5).
USPTO_ROUTES_PKL=
USPTO_ROUTES_HDF5=

# Vendor price APIs for the cost pillar (disabled unless a key is present).
# Live lookups also need a separate ChemPriceClient package that is not part of
# this repository; without it the cost pillar uses a built-in price heuristic.
# See the deployment table in the root README.
# The shipped pricing adapter disables MCule.
# MOLPORT_API_KEY=
# CHEMSPACE_API_KEY=
